# Modèle : copier ce fichier sur PythonAnywhere sous le nom ~/rehoboth.env
# (en dehors du dépôt Git), puis remplir les valeurs. Ne jamais le committer.
# Permissions : chmod 600 ~/rehoboth.env

SITE_URL="https://NOM_UTILISATEUR.pythonanywhere.com"
HTTPS=1
SECRET_KEY="coller-ici-le-resultat-de-secrets.token_hex(32)"
ADMIN_USER="admin"
ADMIN_PASSWORD="choisir-un-mot-de-passe-solide"
DATABASE="/home/NOM_UTILISATEUR/rehoboth/data/inscriptions.db"

# Google Analytics (facultatif) : identifiant de mesure G-XXXXXXXXXX. Laisser vide = aucun suivi.
GA_MEASUREMENT_ID=""

# Jeton API PythonAnywhere (onglet Account > API token), pour recharger le site automatiquement
PA_TOKEN="coller-ici-le-jeton-api"
PA_USER="NOM_UTILISATEUR"
PA_DOMAINE="NOM_UTILISATEUR.pythonanywhere.com"
